{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": ["-I", "-c", "import sys; sys.path.insert(0, sys.argv[1]); import longhaul; sys.exit(longhaul.main(['guard']))", "${CLAUDE_PLUGIN_ROOT}"],
            "timeout": 5,
            "statusMessage": "Checking this call (longhaul guard)"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "compact|clear",
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": ["-I", "-c", "import sys; sys.path.insert(0, sys.argv[1]); import longhaul; sys.exit(longhaul.main(['guard']))", "${CLAUDE_PLUGIN_ROOT}"],
            "timeout": 5,
            "statusMessage": "Forgetting this session's reads (longhaul guard)"
          }
        ]
      },
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": ["-I", "-c", "import sys; sys.path.insert(0, sys.argv[1]); import longhaul; sys.exit(longhaul.main(['guard']))", "${CLAUDE_PLUGIN_ROOT}"],
            "timeout": 5,
            "statusMessage": "Looking for a code index (longhaul guard)"
          }
        ]
      },
      {
        "matcher": "compact|clear|resume",
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": ["-I", "-c", "import sys; sys.path.insert(0, sys.argv[1]); import longhaul; sys.exit(longhaul.main(['checkpoint']))", "${CLAUDE_PLUGIN_ROOT}"],
            "timeout": 5,
            "statusMessage": "Looking for a checkpoint (longhaul checkpoint)"
          }
        ]
      }
    ]
  }
}
